{
  "contract": "kowa.runtime-web.v1",
  "owner": "backend:S04",
  "schema": "schema.json",
  "schemaSha256": "a745c56377b96f952b8cd95c8f2e3df35b7cb6a808328c3edabbefc5e8cef7b1",
  "operations": {
    "runtime.list": {
      "method": "GET",
      "path": "/api/v1/workspaces/{workspaceID}/runtimes",
      "layer": "http",
      "authorization": "session+member"
    },
    "runtime.view": {
      "method": "GET",
      "path": "/api/v1/workspaces/{workspaceID}/runtimes/{runtimeID}",
      "layer": "http",
      "authorization": "session+member+authorized-runtime"
    },
    "executionConfig.read": {
      "method": "GET",
      "path": "/api/v1/workspaces/{workspaceID}/execution-config",
      "layer": "http",
      "authorization": "session+member"
    },
    "executionConfig.update": {
      "method": "PUT",
      "path": "/api/v1/workspaces/{workspaceID}/execution-config",
      "layer": "http",
      "authorization": "session+admin+csrf"
    }
  }
}
